<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.1 is the floor the renderer needs; the Adreno 740 reports 1.3.
         Declared as required so the Play Store would filter out devices that
         cannot run it. -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x00401000"
                  android:required="true" />

    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- All-files access, so the game can read Selaco.ipk3 from a folder the user can
         actually reach. The app's own external files dir needs no permission, but since
         Android 11 it is unreachable by the user: the Files app and MTP both refuse to
         enter Android/data, and it is mode 770 owned by the app - so it only works via
         adb. Public storage also survives uninstalling the app, which Android/data does
         not (it is deleted along with a 1.1 GB game file).
         MANAGE_EXTERNAL_STORAGE rather than READ_EXTERNAL_STORAGE because .ipk3 is not
         a media type, so the Android 13 READ_MEDIA_* permissions cannot see it. This
         permission needs a Play Store declaration; it is unrestricted for sideloaded
         and GitHub-release builds. SelacoActivity requests it on startup, and the game
         still runs from $PROGDIR if it is declined. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- MANAGE_EXTERNAL_STORAGE does not exist before API 30, and minSdk is 26. Without this
         the 26-29 window has NO public-storage access at all: hasAllFilesAccess() returns true
         there only because the check is inapplicable, so the app sails past the permission gate
         and the engine then cannot see /sdcard/Selaco, failing with a generic "cannot find a
         game IWAD" that points at nothing. maxSdkVersion keeps it out of the way on 30+, where
         MANAGE_EXTERNAL_STORAGE is the mechanism. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- The vendored SDL calls Vibrator.vibrate() from SDLControllerManager whenever the engine
         rumbles, and joy_feedback defaults to true (m_joy.cpp). Without this the first rumble
         throws SecurityException; SDL catches the first call but its fallback and
         SDLHapticHandler.run are unguarded, and Android_JNI_HapticRun does no ExceptionCheck, so
         a pending exception is left at the JNI boundary. Cheap to declare, and it is a normal
         (non-runtime) permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Selaco"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:theme="@style/GameTheme"
        android:extractNativeLibs="true">

        <!-- configChanges: handle these ourselves rather than letting Android
             recreate the activity. A restart would tear down the Vulkan surface
             and the whole engine with it. -->
        <activity
            android:name=".SelacoActivity"
            android:exported="true"
            android:label="Selaco"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:preferMinimalPostProcessing="true"
            android:resizeableActivity="false"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density">

            <meta-data android:name="android.app.lib_name" android:value="Selaco" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
