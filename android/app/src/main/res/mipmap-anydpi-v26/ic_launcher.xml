<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). The launcher masks this to its own shape and shows only
     the central 72 of 108 dp. The foreground is Selaco's Windows icon art (src/win32/icon1.ico)
     scaled to fill that area, so the mask hides the art's flat-cut bottom and right edges;
     its transparent areas sit on a dark background matching the art. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
