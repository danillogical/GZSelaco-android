<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). The launcher masks this to its own shape and crops
     roughly 25% off each edge, so the artwork is inset into the safe zone by
     ic_launcher_foreground and sits on a dark background matching the key art. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
