<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Games get the screen to themselves. Without an explicit theme the activity
        inherits the platform default, which draws an ActionBar showing
        android:label - that is the stray "Menu" title bar over the top of the
        game.

        windowLayoutInDisplayCutoutMode is set programmatically in
        SelacoActivity.goImmersive() rather than here, because this theme has no
        version-qualified variant and the attribute is API 27.
    -->
    <style name="GameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!-- No activity transition animations; they fight with SDL's surface setup. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
